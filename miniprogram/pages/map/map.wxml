<view class="page">

  <view class="head">
    <view class="locrow">
      <view class="row">
        <view class="locdot"></view>
        <text class="strong">{{community}}</text>
      </view>
      <button class="walkbtn {{walking ? '' : 'off'}}" bindtap="onToggleWalk">{{walking ? '结束遛狗' : '开始遛狗'}}</button>
    </view>
    <view class="title">附近有什么狗</view>
    <view class="sub">{{walking ? dogCount + ' 只狗正在遛 · 1 处流浪狗活动区' : '位置已关闭 · 开始遛狗后显示附近的狗'}}</view>
  </view>

  <view class="chips">
    <view wx:for="{{filters}}" wx:key="key" class="chip {{item.on ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onFilter">{{item.label}}</view>
  </view>

  <view class="map-wrap">
    <view class="map-canvas">
      <view class="road road-h" style="top:30%"></view>
      <view class="road road-h" style="top:74%"></view>
      <view class="road road-v" style="left:25%"></view>
      <view class="road road-v" style="left:73%"></view>

      <view class="block" style="left:4%;top:5%;width:17%;height:19%"></view>
      <view class="block" style="left:29%;top:5%;width:15%;height:19%"></view>
      <view class="block" style="left:76%;top:5%;width:18%;height:19%"></view>
      <view class="block" style="left:5%;top:36%;width:15%;height:32%"></view>
      <view class="block" style="left:29%;top:36%;width:15%;height:32%"></view>
      <view class="block" style="left:78%;top:81%;width:17%;height:16%"></view>
      <view class="block" style="left:29%;top:81%;width:15%;height:15%"></view>
      <view class="park" style="left:76%;top:36%;width:19%;height:32%">泾康花园</view>

      <view wx:if="{{showStray}}" class="stray-zone" style="left:{{stray.left}}%;top:{{stray.top}}%" bindtap="onStrayTap">
        <view class="stray-title">流浪狗活动区</view>
        <view class="stray-sub">{{stray.lastSeen}} · {{stray.behavior}}</view>
      </view>

      <view wx:if="{{walking}}" class="me-dot"></view>
      <view wx:if="{{walking}}" class="me-label">我</view>

      <block wx:if="{{walking}}">
        <view wx:for="{{pins}}" wx:key="id" wx:if="{{item.visible}}" class="pin pin-{{item.level}}" style="left:{{item.left}}%;top:{{item.top}}%" data-id="{{item.id}}" bindtap="onDogTap">
          <view class="pin-dot">{{item.avatar}}</view>
          <view class="pin-label">{{item.name}}</view>
        </view>
      </block>

      <button class="sos" bindtap="onSos">SOS</button>

      <view class="legend">
        <view><view class="dot g"></view>可接触　<view class="dot y"></view>先观察　<view class="dot r"></view>保持距离</view>
        <view class="legend-sub">位置已模糊 80–150m</view>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="between" style="margin-bottom:8rpx">
      <view class="panel-title" style="margin:0">附近的狗</view>
      <view class="quickmini" bindtap="onQuickReport">一键目击</view>
    </view>

    <view wx:if="{{!walking}}" class="empty">位置已关闭，点右上角「开始遛狗」后显示附近的狗</view>

    <view wx:for="{{rows}}" wx:key="id" wx:if="{{item.visible}}" class="dogrow" data-id="{{item.id}}" bindtap="onDogTap">
      <view class="avatar avatar-{{item.level}}">{{item.avatar}}</view>
      <view class="grow">
        <view class="dogname">{{item.name}}</view>
        <view class="dogdesc ellipsis">{{item.desc}}</view>
      </view>
      <view class="badge {{item.level}}">{{item.label}}</view>
    </view>

    <view wx:if="{{showStray}}" class="dogrow" bindtap="onStrayTap">
      <view class="avatar avatar-stray">流</view>
      <view class="grow">
        <view class="dogname">流浪狗活动区</view>
        <view class="dogdesc ellipsis">{{stray.lastSeen}}观察：{{stray.behavior}}</view>
      </view>
      <view class="badge y">留意</view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="onCloseModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">{{detail.name}}</view>
      <view class="modal-sub">{{detail.breed}} · {{detail.size}} 型 · {{detail.distance}}m · {{detail.direction}}</view>
      <view class="tagrow">
        <view wx:for="{{detail.tags}}" wx:key="*this" class="tinytag">{{item}}</view>
      </view>
      <view class="reason {{detail.level}}">
        <view class="bold">{{detail.label}}</view>
        <view>{{detail.reason}}</view>
      </view>
      <button class="btn" bindtap="onGreet">打招呼</button>
      <button class="btn ghost" bindtap="onCloseModal">关闭</button>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showStrayDetail}}" bindtap="onCloseModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">流浪狗活动区</view>
      <view class="modal-sub">{{stray.lastSeen}}观察 · {{stray.status}}</view>
      <view class="reason y">
        <view class="bold">留意</view>
        <view>这里只显示活动区域和最近一次行为观察，不显示狗的实时位置。请勿主动驱赶或投喂，已通知物业处理。</view>
      </view>
      <view class="tagrow">
        <view class="tinytag">观察行为：{{stray.behavior}}</view>
        <view class="tinytag">物业已认领</view>
      </view>
      <button class="btn ghost" bindtap="onCloseModal">关闭</button>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showSos}}" bindtap="onCloseModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">一键 SOS</view>
      <view class="modal-sub">广播 500m 内在线狗友，并推送附近合作医院</view>
      <view class="opt" wx:for="{{sosOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSosType">{{item.label}}</view>
      <button class="btn ghost" bindtap="onCloseModal">取消</button>
    </view>
  </view>

</view>
