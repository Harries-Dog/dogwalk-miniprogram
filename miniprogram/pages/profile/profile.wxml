<view class="page">

  <view class="head">
    <view class="title">我的</view>
    <view class="sub">遛遛 · 演示版本</view>
  </view>

  <view class="panel">
    <view class="between">
      <view>
        <view class="panel-title" style="margin:0">{{dog.name}}</view>
        <view class="muted">{{dog.breed}} · {{dog.size}} 型 · {{dog.gender}} · {{dog.neutered ? '已绝育' : '未绝育'}}</view>
      </view>
      <view class="avatar">{{avatar}}</view>
    </view>
    <view class="tagrow">
      <view wx:for="{{tags}}" wx:key="*this" class="tinytag">{{item}}</view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">隐私设置</view>
    <view class="privacy-row">
      <view class="grow">
        <view class="bold">位置默认关闭</view>
        <view class="muted">只在开始遛狗后采集，结束后 5 分钟失效</view>
      </view>
      <view class="badge g">已开启</view>
    </view>
    <view class="privacy-row">
      <view class="grow">
        <view class="bold">地图模糊显示</view>
        <view class="muted">其他狗的位置做 80–150m 偏移</view>
      </view>
      <view class="badge g">已开启</view>
    </view>
    <view class="privacy-row">
      <view class="grow">
        <view class="bold">流浪狗只显示区域</view>
        <view class="muted">不显示实时点位，防止按图驱赶</view>
      </view>
      <view class="badge g">已开启</view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">关于</view>
    <view class="muted">版本 {{version}} · 数据保存在本机 Storage</view>
    <view class="muted">当前为演示版本，狗与工单均为模拟数据，未接后端。</view>
    <button class="btn ghost" bindtap="onReset">重置演示数据</button>
  </view>

</view>
