.locdot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #0f6e56; margin-right: 12rpx;
}
.stats { display: flex; padding: 28rpx 32rpx 12rpx; background: #fff; }
.stat {
  flex: 1;
  background: #f6f5f1;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  margin-right: 12rpx;
}
.stat:last-child { margin-right: 0; }
.stat-num { font-size: 40rpx; font-weight: 600; color: #0f6e56; line-height: 1.3; }
.stat-label { font-size: 20rpx; color: #6b6a65; }
.summary-link { font-size: 22rpx; color: #0f6e56; padding: 10rpx 32rpx 0; background: #fff; }
.tickets { padding: 20rpx 32rpx 60rpx; }
.ticket {
  background: #fff;
  border: 1rpx solid #e6e4dd;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.ticket-title { font-size: 26rpx; font-weight: 500; margin: 10rpx 0 4rpx; }
.empty {
  font-size: 22rpx; color: #6b6a65;
  background: #f6f5f1; border-radius: 14rpx;
  padding: 30rpx; text-align: center;
}
